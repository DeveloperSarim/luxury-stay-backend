# Copy to .env and fill in. Never commit the real .env - it is gitignored.

# ---------- server ----------
PORT=5000

# Controls whether error responses include a stack trace.
# Leave this unset in production and the API returns full stack traces to the
# client on every error (see middleware/errorMiddleware.js).
NODE_ENV=development

# ---------- database ----------
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/luxurystay

# ---------- auth ----------
# Long random string. Anyone holding this can mint valid tokens.
JWT_SECRET=change_me_to_a_long_random_string

# ---------- email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail this is an App Password, not your account password.
SMTP_PASS=your_app_password

# ---------- client ----------
FRONTEND_URL=http://localhost:5173
